#!/usr/bin/env bash
# tailScaleExpiry — report this node's Tailscale key expiry, re-authenticate it,
# and optionally schedule a Slack nudge-to-self a few business days ahead.
#
# Node keys on user-owned (untagged) devices expire — the tailnet policy sets the
# period, Tailscale's default is 180 days, flexcompute.com's is ~2 months — and the
# node drops off the tailnet until someone re-authenticates it at the console.
# Tagged devices have key expiry disabled automatically; untagged ones need an
# admin to "Disable key expiry" on the Machines page.
#   https://tailscale.com/kb/1028/key-expiry
#
# Usage:
#   tailScaleExpiry                 # human summary; exit 1 if expired/logged out
#   tailScaleExpiry --raw           # just the ISO 8601 timestamp
#   tailScaleExpiry --json          # machine-readable
#   tailScaleExpiry --remind        # schedule a Slack DM-to-self (see below)
#   tailScaleExpiry --refresh       # re-authenticate this node now
#
# Options:
#   -r, --raw        Print .Self.KeyExpiry verbatim and exit
#   -j, --json       Print {hostname, expiry, days_left, expired, state} as JSON
#       --remind     Schedule a Slack reminder to self
#       --days N     Business days of lead time for --remind (default 3)
#       --at HH:MM   Local time of day for the reminder (default 09:00)
#       --dry-run    With --remind, print the plan without calling Slack
#       --refresh    Run the re-auth flow (prints a login URL to open)
#       --force      Allow --refresh over SSH (it can drop the connection)
#       --diagnose   Show WSL/Linux detection and both Tailscale client probes
#       --full       Alias for --diagnose
#       --linux      Override auto-detection; use the Linux/WSL daemon only
#       --windows    Override auto-detection; use the Windows client (WSL only)
#                    Without either flag, the usable client is detected automatically.
#   -h, --help       This help
#
# --remind targets N business days BEFORE the key expires, so the nudge lands while
# the node still works. If that moment has already passed (or the key is already
# expired) it targets N business days from today instead. Weekends are skipped in
# both directions.
#
# Slack delivery uses chat.scheduleMessage, which needs a token in $SLACK_TOKEN
# (or $SLACK_USER_TOKEN / $SLACK_BOT_TOKEN) with the chat:write scope. A user token
# (xoxp-) posts into your own DM; a bot token DMs you from the app. The API caps
# scheduling at 120 days out; if the target lands beyond that the script falls back
# to printing a /remind line for you to paste (copied to the clipboard when xclip is
# present). Set $SLACK_REMIND_CHANNEL to a conversation ID to skip the auth.test
# lookup — the self-DM here is Dr0BDWJURCLD.
#
# Exit codes: 0 key valid · 1 expired or logged out · 2 usage/runtime error

set -uo pipefail

readonly SLACK_API='https://slack.com/api'
readonly SCHEDULE_LIMIT_DAYS=120

RAW=0
JSON=0
REMIND=0
REFRESH=0
DRY_RUN=0
FORCE=0
DIAGNOSE=0
PLATFORM='auto'
LEAD_DAYS=3
AT_TIME='09:00'

die() {
  printf 'tailScaleExpiry: %s\n' "$1" >&2
  exit 2
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

while (($# > 0)); do
  case "$1" in
  -r | --raw) RAW=1 ;;
  -j | --json) JSON=1 ;;
  --remind) REMIND=1 ;;
  --refresh) REFRESH=1 ;;
  --dry-run) DRY_RUN=1 ;;
  --force) FORCE=1 ;;
  --diagnose | --full) DIAGNOSE=1 ;;
  --linux) PLATFORM='linux' ;;
  --windows) PLATFORM='windows' ;;
  --days)
    [ $# -ge 2 ] || die '--days needs a value'
    LEAD_DAYS=$2
    shift
    ;;
  --at)
    [ $# -ge 2 ] || die '--at needs a value'
    AT_TIME=$2
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

[[ $LEAD_DAYS =~ ^[0-9]+$ ]] || die "--days must be a non-negative integer, got: $LEAD_DAYS"
[[ $AT_TIME =~ ^[0-9]{1,2}:[0-9]{2}$ ]] || die "--at must be HH:MM, got: $AT_TIME"

for cmd in jq date; do
  command -v "$cmd" >/dev/null 2>&1 || die "$cmd not found in PATH"
done

is_wsl() {
  [[ -n "${WSL_DISTRO_NAME:-}" || -r /proc/version ]] &&
    grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null
}

find_windows_tailscale() {
  local candidate
  candidate=$(command -v tailscale.exe 2>/dev/null || true)
  if [[ -n "$candidate" && -x "$candidate" ]]; then
    printf '%s' "$candidate"
    return 0
  fi

  for candidate in \
    '/mnt/c/Program Files/Tailscale/tailscale.exe' \
    '/mnt/c/Program Files (x86)/Tailscale/tailscale.exe'; do
    if [[ -x "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

valid_status_json() {
  jq -e 'type == "object" and (.Self | type == "object")' >/dev/null 2>&1 <<<"$1"
}

STATUS=''
STATUS_ERROR=''
STATUS_SOURCE='linux'
TAILSCALE_CMD=(tailscale)
LOCAL_BACKEND_STATE=''
LINUX_TAILSCALE=''
LINUX_STATUS_ERROR='not probed'
WINDOWS_TAILSCALE=''
WINDOWS_STATUS_ERROR='not probed'

if is_wsl; then
  DETECTED_PLATFORM="WSL2 (${WSL_DISTRO_NAME:-unknown distro})"
else
  DETECTED_PLATFORM='Linux'
fi

if [[ "$PLATFORM" != windows ]]; then
  if command -v tailscale >/dev/null 2>&1; then
    LINUX_TAILSCALE=$(command -v tailscale)
    STATUS=$(tailscale status --json 2>&1)
    status_exit=$?
    if ((status_exit == 0)) && valid_status_json "$STATUS"; then
      LINUX_STATUS_ERROR='reachable'
      LOCAL_BACKEND_STATE=$(jq -r '.BackendState // empty' <<<"$STATUS")
      :
    else
      LINUX_STATUS_ERROR=$STATUS
      STATUS_ERROR=$LINUX_STATUS_ERROR
      STATUS=''
    fi
  else
    LINUX_STATUS_ERROR='tailscale not found in PATH'
    STATUS_ERROR=$LINUX_STATUS_ERROR
  fi
fi

if [[ "$PLATFORM" != linux ]] && {
  ((DIAGNOSE)) ||
  [[ -z "$STATUS" ]] ||
  { is_wsl && [[ "$PLATFORM" == auto && "$LOCAL_BACKEND_STATE" =~ ^(NeedsLogin|NoState|Stopped)$ ]]; }
}; then
  if ! is_wsl; then
    [[ "$PLATFORM" == windows ]] && die '--windows is only available inside WSL'
  else
    WINDOWS_TAILSCALE=$(find_windows_tailscale || true)
    if [[ -n "$WINDOWS_TAILSCALE" ]]; then
      WINDOWS_STATUS=$("$WINDOWS_TAILSCALE" status --json 2>&1)
      windows_status_exit=$?
      if ((windows_status_exit == 0)) && valid_status_json "$WINDOWS_STATUS"; then
        WINDOWS_STATUS_ERROR='reachable'
        if [[ -z "$STATUS" || "$LOCAL_BACKEND_STATE" =~ ^(NeedsLogin|NoState|Stopped)$ ]]; then
          STATUS=$WINDOWS_STATUS
          STATUS_SOURCE='windows'
          TAILSCALE_CMD=("$WINDOWS_TAILSCALE")
        fi
      else
        WINDOWS_STATUS_ERROR=$WINDOWS_STATUS
        STATUS_ERROR="${STATUS_ERROR:+$STATUS_ERROR; }Windows client: $WINDOWS_STATUS_ERROR"
      fi
    else
      WINDOWS_STATUS_ERROR='tailscale.exe not found'
      STATUS_ERROR="${STATUS_ERROR:+$STATUS_ERROR; }$WINDOWS_STATUS_ERROR"
    fi
  fi
fi

if ((DIAGNOSE)); then
  printf 'Environment: %s\n' "$DETECTED_PLATFORM"
  printf 'Selection:   %s\n' "$PLATFORM"
  printf 'Linux CLI:   %s\n' "${LINUX_TAILSCALE:-not found}"
  printf 'Linux daemon: %s\n' "$LINUX_STATUS_ERROR"
  if is_wsl; then
    printf 'Windows CLI: %s\n' "${WINDOWS_TAILSCALE:-not found}"
    printf 'Windows client: %s\n' "$WINDOWS_STATUS_ERROR"
  fi
  if [[ -n "$STATUS" ]]; then
    printf 'Selected client: %s\n' "$STATUS_SOURCE"
  else
    printf 'Selected client: none\n'
  fi
fi

if [[ -z "$STATUS" ]]; then
  # A diagnostic-only run is useful precisely when neither daemon is
  # reachable, so do not turn that report into a runtime error.
  ((DIAGNOSE && !REFRESH && !REMIND)) && exit 0
  if is_wsl; then
    case "$PLATFORM" in
    linux)
      die "Linux Tailscale daemon is unavailable. Run 'sudo systemctl start tailscaled', or use --full for details"
      ;;
    windows)
      die "Windows Tailscale client is unavailable. Open Tailscale in Windows, or use --full for details"
      ;;
    *)
      die "No usable Tailscale client found in WSL2. Check the Windows Tailscale app, or run 'sudo systemctl start tailscaled'; use --full for details"
      ;;
    esac
  fi
  die "Tailscale is unavailable. Use --full for details"
fi

read -r HOSTNAME_TS STATE EXPIRY < <(
  jq -r '[(.Self.HostName // "?"), (.BackendState // "?"), (.Self.KeyExpiry // "")] | @tsv' <<<"$STATUS"
)

reauth_command() {
  local -a args=(up --ssh)
  case "$STATE" in
  NeedsLogin | NoState | Stopped) ;;
  *) args+=(--force-reauth) ;;
  esac

  printf '%q ' "${TAILSCALE_CMD[@]}" "${args[@]}"
}

run_reauth() {
  local -a args=(up --ssh)
  case "$STATE" in
  NeedsLogin | NoState | Stopped) ;;
  *) args+=(--force-reauth) ;;
  esac

  if [ -n "${SSH_CONNECTION:-}" ] && ((!FORCE)); then
    die 're-auth over SSH can drop this connection; run it at the console, or pass --force'
  fi
  printf 'Running: '
  printf '%q ' "${TAILSCALE_CMD[@]}" "${args[@]}"
  printf '\n'
  "${TAILSCALE_CMD[@]}" "${args[@]}"
}

case "$STATE" in
NeedsLogin | NoState)
  if ((REFRESH)); then
    run_reauth
    exit $?
  fi
  if ((JSON)); then
    AUTH_URL=$(jq -r '.AuthURL // empty' <<<"$STATUS")
    jq -n --arg h "$HOSTNAME_TS" --arg s "$STATE" --arg source "$STATUS_SOURCE" \
      --arg auth_url "$AUTH_URL" \
      '{hostname:$h, expiry:null, days_left:null, expired:false, state:$s, source:$source, auth_url:(if $auth_url == "" then null else $auth_url end)}'
    exit 1
  fi
  AUTH_URL=$(jq -r '.AuthURL // empty' <<<"$STATUS")
  printf '%s: Tailscale is not logged in (%s client).\n' "$HOSTNAME_TS" "$STATUS_SOURCE"
  if [[ -n "$AUTH_URL" ]]; then
    printf '  Open this URL to sign in: %s\n' "$AUTH_URL"
  else
    printf '  Run: %s\n' "$(reauth_command)"
  fi
  exit 1
  ;;
Stopped)
  if ((REFRESH)); then
    run_reauth
    exit $?
  fi
  if ((JSON)); then
    jq -n --arg h "$HOSTNAME_TS" --arg s "$STATE" --arg source "$STATUS_SOURCE" \
      '{hostname:$h, expiry:null, days_left:null, expired:false, state:$s, source:$source, auth_url:null}'
    exit 1
  fi
  printf '%s: Tailscale is stopped (%s client).\n' "$HOSTNAME_TS" "$STATUS_SOURCE"
  printf '  Run: %s\n' "$(reauth_command)"
  exit 1
  ;;
esac

# Tagged nodes and nodes with expiry disabled report no KeyExpiry at all.
if [ -z "$EXPIRY" ]; then
  if ((REFRESH)); then
    printf '%s: key expiry disabled (tagged or exempted); attempting the requested re-auth via %s\n' \
      "$HOSTNAME_TS" "$STATUS_SOURCE"
    run_reauth
    exit $?
  fi
  ((RAW)) && exit 0
  if ((JSON)); then
    jq -n --arg h "$HOSTNAME_TS" --arg s "$STATE" \
      --arg source "$STATUS_SOURCE" \
      '{hostname:$h, expiry:null, days_left:null, expired:false, state:$s, source:$source}'
  else
    printf '%s: key expiry disabled (tagged or exempted) — nothing to refresh\n' "$HOSTNAME_TS"
  fi
  exit 0
fi

((RAW)) && {
  printf '%s\n' "$EXPIRY"
  exit 0
}

EXPIRY_EPOCH=$(date -d "$EXPIRY" +%s 2>/dev/null) || die "could not parse KeyExpiry: $EXPIRY"
NOW_EPOCH=$(date +%s)
EXPIRY_DATE=$(date -d "@$EXPIRY_EPOCH" +%F)
SECONDS_LEFT=$((EXPIRY_EPOCH - NOW_EPOCH))
EXPIRED=$((SECONDS_LEFT <= 0 ? 1 : 0))
# Floor, not truncate-toward-zero: 16h past expiry is -1 day, not 0.
if ((SECONDS_LEFT >= 0)); then
  DAYS_LEFT=$((SECONDS_LEFT / 86400))
else
  DAYS_LEFT=$((-((-SECONDS_LEFT + 86399) / 86400)))
fi

# Shift by whole business days in either direction; the start day is never counted.
shift_business_days() {
  local day=$1 count=$2 step=$3 # step is a signed count: +1 or -1
  while ((count > 0)); do
    day=$(date -d "$day $step day" +%F)
    (($(date -d "$day" +%u) < 6)) && count=$((count - 1))
  done
  printf '%s' "$day"
}

if ((REFRESH)); then
  run_reauth
  exit $?
fi

if ((JSON)); then
  jq -n --arg h "$HOSTNAME_TS" --arg e "$EXPIRY" --arg s "$STATE" \
    --argjson d "$DAYS_LEFT" --argjson x "$EXPIRED" \
    '{hostname:$h, expiry:$e, days_left:$d, expired:($x==1), state:$s}'
elif ((!REMIND)); then
  if ((EXPIRED)); then
    printf '%s: key expired %s\n' "$HOSTNAME_TS" \
      "$(date -d "@$EXPIRY_EPOCH" '+%a %d %b %Y %H:%M %Z')"
    ago=$((-SECONDS_LEFT))
    if ((ago < 86400)); then
      printf '  EXPIRED %d hour(s) ago — backend state: %s\n' "$((ago / 3600))" "$STATE"
    else
      printf '  EXPIRED %d day(s) ago — backend state: %s\n' "$((ago / 86400))" "$STATE"
    fi
    printf '  Refresh at the console:  %s\n' "$(reauth_command)"
  else
    printf '%s: key expires %s (%d day(s) left)\n' "$HOSTNAME_TS" \
      "$(date -d "@$EXPIRY_EPOCH" '+%a %d %b %Y %H:%M %Z')" "$DAYS_LEFT"
  fi
fi

((REMIND)) || exit "$EXPIRED"

# Prefer landing the nudge LEAD_DAYS business days before expiry; if that is already
# behind us, aim the same distance ahead of today instead.
TODAY=$(date +%F)
if ((EXPIRED)); then
  TARGET_DATE=$(shift_business_days "$TODAY" "$LEAD_DAYS" '+1')
  BASIS="$LEAD_DAYS business day(s) from today (key already expired)"
else
  TARGET_DATE=$(shift_business_days "$EXPIRY_DATE" "$LEAD_DAYS" '-1')
  if [[ $(date -d "$TARGET_DATE $AT_TIME" +%s) -le $NOW_EPOCH ]]; then
    TARGET_DATE=$(shift_business_days "$TODAY" "$LEAD_DAYS" '+1')
    BASIS="$LEAD_DAYS business day(s) from today (expiry is sooner than the lead time)"
  else
    BASIS="$LEAD_DAYS business day(s) before expiry"
  fi
fi

POST_AT=$(date -d "$TARGET_DATE $AT_TIME" +%s)
WHEN_HUMAN=$(date -d "@$POST_AT" '+%a %d %b %Y at %H:%M %Z')
TEXT="Refresh the Tailscale key on ${HOSTNAME_TS} — it expires ${EXPIRY_DATE}. Run at the console: $(reauth_command)"
SLASH="/remind me to refresh the Tailscale key on ${HOSTNAME_TS} (expires ${EXPIRY_DATE}) at ${AT_TIME} on $(date -d "$TARGET_DATE" '+%B %-d, %Y')"

printf '\nReminder target: %s\n  basis: %s\n  text:  %s\n' "$WHEN_HUMAN" "$BASIS" "$TEXT"

paste_fallback() {
  printf '\nPaste this into Slack:\n  %s\n' "$SLASH"
  if command -v xclip >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    printf '%s' "$SLASH" | xclip -selection clipboard && printf '  (copied to clipboard)\n'
  fi
}

TOKEN=${SLACK_TOKEN:-${SLACK_USER_TOKEN:-${SLACK_BOT_TOKEN:-}}}

if ((DRY_RUN)); then
  printf '\n--dry-run: nothing sent.\n'
  paste_fallback
  exit "$EXPIRED"
fi

if [ -z "$TOKEN" ]; then
  printf '\nNo $SLACK_TOKEN set, so nothing was scheduled.\n'
  paste_fallback
  exit "$EXPIRED"
fi

if ((POST_AT - NOW_EPOCH > SCHEDULE_LIMIT_DAYS * 86400)); then
  printf '\nThat is more than %d days out — past the chat.scheduleMessage limit.\n' "$SCHEDULE_LIMIT_DAYS"
  paste_fallback
  exit "$EXPIRED"
fi

command -v curl >/dev/null 2>&1 || die 'curl not found in PATH'

slack_post() {
  curl -sS -X POST "$SLACK_API/$1" \
    -H "Authorization: Bearer $TOKEN" \
    -H 'Content-type: application/json; charset=utf-8' \
    --data "$2"
}

CHANNEL=${SLACK_REMIND_CHANNEL:-}
if [ -z "$CHANNEL" ]; then
  AUTH=$(curl -sS -H "Authorization: Bearer $TOKEN" "$SLACK_API/auth.test") ||
    die 'could not reach the Slack API'
  jq -e '.ok' >/dev/null <<<"$AUTH" ||
    die "Slack auth.test failed: $(jq -r '.error // "unknown"' <<<"$AUTH")"
  # chat.* resolves a user ID to that user's DM conversation.
  CHANNEL=$(jq -r '.user_id' <<<"$AUTH")
fi

PAYLOAD=$(jq -n --arg c "$CHANNEL" --arg t "$TEXT" --argjson p "$POST_AT" \
  '{channel:$c, text:$t, post_at:$p}')
RESP=$(slack_post chat.scheduleMessage "$PAYLOAD") || die 'could not reach the Slack API'

if jq -e '.ok' >/dev/null <<<"$RESP"; then
  printf '\nScheduled in Slack (%s), id %s\n' "$CHANNEL" "$(jq -r '.scheduled_message_id' <<<"$RESP")"
else
  printf '\nSlack rejected the schedule: %s\n' "$(jq -r '.error // "unknown"' <<<"$RESP")" >&2
  paste_fallback
  exit 2
fi

exit "$EXPIRED"
